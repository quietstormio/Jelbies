<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets CADisplayLink / MTKView run above 60 Hz on ProMotion iPhones (RateGovernor requests 120 only with GPU headroom). -->
	<key>CADisableMinimumFrameDuration</key>
	<true/>
	<!-- The widget's deep link: jelbies://jelly/<id> opens the game and selects that Jelly. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.mgsllc.BobV1</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jelbies</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
