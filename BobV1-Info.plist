<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets CADisplayLink / MTKView run above 60 Hz on ProMotion iPhones (RateGovernor requests 120 only with GPU headroom).
	     The documented key is ...OnPhone; the earlier `CADisableMinimumFrameDuration` had no effect. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Game Mode (iOS 18 / 26): fewer background interruptions and lower Bluetooth latency while the game is up. -->
	<key>GCSupportsGameMode</key>
	<true/>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.simulation-games</string>
	<!-- Live Activities (race / nap / Pep refill): local updates only, no push. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>
	<!-- Siri: "Jelbies" also names the app in App Shortcut phrases (the display name is "Bob" today). -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Jelbies</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>jell bees</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>My Jelbies</string>
		</dict>
	</array>
	<!-- The widget's deep link: jelbies://jelly/<id> opens the game and selects that Jelly. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.mgsllc.BobV1</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jelbies</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
