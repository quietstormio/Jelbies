{
 "purpose": "Repaint the existing procedural shoe shell (ShoeModel.buildShell). Geometry, thickness(u) and the (u,v,sx) definitions are UNCHANGED.",
 "coordinates": {
  "u": "0 sole .. 1 crown (normalised foot-local y of the planted bean) ",
  "v": "0 heel .. 1 toe (z)",
  "sx": "0 foot centre-line .. 1 outer side (|x|/max|x|, symmetric for both feet)"
 },
 "window": "w = rise(a-e,a+e,x) * (1 - rise(b-e,b+e,x)), rise=smoothstep; a or b = null means open. A layer weight = w(u)*w(v)*w(sx) (* bars or speckle) * alpha.",
 "evaluation": "col = base; for each layer in listed order: col = mix(col, layer.colour, weight). Later layers win (outsole last). Colours sRGB 0..1; convert with OKLab.srgbToLinear like palette() does.",
 "tiers": {
  "A": "survives the existing 418-vertex shell (bands >= ~0.05 in u/v). Ship this first.",
  "B": "laces, tongue, stitch line and glitter dots need ~0.025 features: needs a 2x denser shell (one midpoint subdivision of FootBean.triangles for shoes only = 1666 verts/foot, built from the same bean verts; the sim bean is untouched). Without it they alias into zigzags (see shoes_reference.png)."
 },
 "swift_sketch": "for i in verts { var c = base; for L in layers where tier allowed { let w = win(u[i],L.u)*win(v[i],L.v)*win(sx[i],L.sx)*(L.bars?barsW(v[i]):1)*L.alpha; c = mix(c, L.colour, w) } ; color = srgbToLinear(c) }",
 "speckle": "glitter dots: weight *= step(1 - density, fract(sin(u*f1 + v*91.7 + sx*37.1)*43758.5453)); Swift keeps its time-based twinkling diamonds on top.",
